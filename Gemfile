source "https://rubygems.org"

# GitHub Pages build environment (matches what github.io uses in production).
# Local `bundle exec jekyll serve` needs Ruby dev headers installed
# (e.g. `dnf install ruby-devel gcc make`) to compile native gems.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
end
